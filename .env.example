PORT=4000
# Used to derive the key that encrypts device passwords at rest. Change this
# to a long random value in any real deployment — if it changes, previously
# stored device passwords can no longer be decrypted.
APP_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/hik-mgr.sqlite

# Login credentials for the whole app (a single admin account — this isn't
# multi-user). Falls back to admin/dev-only-insecure-password-change-me if
# unset, so a fresh checkout is usable immediately — set real values before
# running this anywhere beyond your own machine.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: seed the first Hikvision device from these instead of adding it
# by hand through the UI. Only used once, at startup, and only if the
# devices table is still empty — HIK_HOST and HIK_PASSWORD must both be set
# for seeding to happen at all. Leave them unset/commented to skip seeding
# and manage devices entirely through the app.
# HIK_NAME=Front Gate
# HIK_HOST=b22.kozow.com
# HIK_PORT=80
# HIK_PROTOCOL=http
# HIK_USERNAME=admin
# HIK_PASSWORD=change-me
