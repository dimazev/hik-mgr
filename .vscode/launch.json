{
  "version": "0.2.0",
  "configurations": [
    {
      // DEFAULT F5 TARGET (first in this list). Builds packages/shared and
      // apps/web first (via the preLaunchTask — apps/web/dist has to exist
      // or server.ts never registers static/catch-all routes, which is
      // exactly why hitting :4000 was 404ing before this config existed),
      // then launches the server directly under Node's debugger via tsx
      // (breakpoints work straight in the .ts sources, no separate server
      // compile step). Once the server actually logs that it's listening,
      // serverReadyAction opens it in your browser automatically — press
      // F5 and everything (build, run, browser) happens on its own.
      "type": "node",
      "request": "launch",
      "name": "Debug Server (single port :4000, build + run + open browser)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx", "./apps/server/src/index.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "preLaunchTask": "build: shared + web (for single-port server)",
      "restart": true,
      "serverReadyAction": {
        "pattern": "hik-mgr server listening on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      // Faster alternative when you only care about the API and don't
      // need the web client served: same debugger setup, but only builds
      // packages/shared first, not apps/web. Hitting :4000/api/... works;
      // :4000/ (the web app) 404s unless apps/web/dist already exists
      // from an earlier build.
      "type": "node",
      "request": "launch",
      "name": "Debug Server (API only, no web build)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx", "./apps/server/src/index.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "preLaunchTask": "build:shared",
      "restart": true
    },
    {
      // Debug an already-running server (e.g. one started with `yarn dev`
      // in a terminal) instead of launching a new one — handy since
      // `tsx watch` already restarts on file changes on its own.
      // Requires the server to actually be started with an inspector
      // listening; NODE_OPTIONS=--inspect yarn dev, or add --inspect to
      // the "dev" script's tsx invocation if you use this often.
      "type": "node",
      "request": "attach",
      "name": "Attach to Server (port 9229)",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      // For active web development with hot-reload: starts the Vite dev
      // server on :5173 (via the "web: dev" task, proxying /api to :4000
      // — the server itself needs to be running separately, e.g. via
      // "Debug Server (API only, no web build)" above) and opens it in a
      // debuggable Chrome instance, breakpoints working in the .tsx
      // sources directly. Not part of the single-port setup — this is the
      // two-port dev workflow (see the "Full Stack (two ports)" compound
      // below to run both at once).
      "type": "chrome",
      "request": "launch",
      "name": "Launch Web (Chrome, :5173 dev server)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web",
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${webRoot}/node_modules/*",
        "webpack:///./*": "${webRoot}/*",
        "webpack:///*": "*"
      },
      "preLaunchTask": "web: dev"
    }
  ],
  "compounds": [
    {
      // The two-port dev workflow, both debuggable at once: API server +
      // Vite dev server + browser. Prefer the single-port config above
      // for a plain "F5 and it just works" experience — use this one
      // specifically when you want the web client's hot-reload.
      "name": "Full Stack (two ports): Server + Web",
      "configurations": ["Debug Server (API only, no web build)", "Launch Web (Chrome, :5173 dev server)"],
      "stopAll": true
    }
  ]
}
