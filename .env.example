PORT=4000
# Used to derive the key that encrypts device passwords at rest. Change this
# to a long random value in any real deployment — if it changes, previously
# stored device passwords can no longer be decrypted.
APP_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/hik-mgr.sqlite

# Login credentials for the whole app (a single admin account — this isn't
# multi-user). Falls back to admin/dev-only-insecure-password-change-me if
# unset, so a fresh checkout is usable immediately — set real values before
# running this anywhere beyond your own machine.
ADMIN_USERNAME=admin
# Whether the login cookie is marked Secure (HTTPS only). Leave false when
# the app is reached over plain http on a LAN; set true behind HTTPS. If
# unset, it is true in production (NODE_ENV=production) and false otherwise.
# COOKIE_SECURE=false
ADMIN_PASSWORD=change-me

# Optional: seed the first Hikvision device from these instead of adding it
# by hand through the UI. Only used once, at startup, and only if the
# devices table is still empty — HIK_HOST and HIK_PASSWORD must both be set
# for seeding to happen at all. Leave them unset/commented to skip seeding
# and manage devices entirely through the app.
# HIK_NAME=Front Gate
# HIK_HOST=b22.kozow.com
# HIK_PORT=80
# HIK_PROTOCOL=http
# HIK_USERNAME=admin
# HIK_PASSWORD=change-me

# A converted video bigger than this (MB, default 100) is cut into the fewest equal parts that each stay under it
# (150 MB -> 2 parts). The cut is a stream copy, so the quality is not changed.
# CONVERT_MAX_PART_MB=100

# Every converted video is cut into at least this many parts (default 2), even a small one - a single file can still
# be too big for WhatsApp to accept as a video. Lower CONVERT_MAX_PART_MB for more/smaller parts.
# CONVERT_MIN_PARTS=2

# Time zone used for the names of downloaded files of older tasks (they stored UTC times). New tasks store your browser's
# local time and do not need it. Example: DISPLAY_TZ=Asia/Jerusalem
# DISPLAY_TZ=
